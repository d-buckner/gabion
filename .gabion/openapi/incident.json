          "check_id": {
            "type": "string"
          },
          "ok": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "pct": {
            "description": "Whole percent, rounded down. `100` only when every probe in the window\ncame back, so a watch with no history is `0`, not `100`.",
            "format": "uint8",
